#!/usr/bin/env bash

# Helper for checking a systemd unit's recent journal against an extended-
# regex pattern, for services that can stay "active" while doing no useful
# work (e.g. a queue consumer whose GPU/model backend broke).
#
# Two modes:
#   user   - a systemd --user unit; must be run as (or sudo'd into) the
#            owning user, same as check_systemd_user_service's -U path.
#   system - a plain system-wide unit; runs journalctl directly as the
#            invoking user (no sudo/impersonation), and therefore requires
#            that user to have system-journal read access (root, or
#            membership in the systemd-journal/adm group - see README).
#
# Usage: check_systemd_journal <user|system> <unit> <lookback> <pattern>

OK=0
CRITICAL=2
UNKNOWN=3

if [ "$#" -ne 4 ]; then
    echo "Usage: $0 <user|system> <unit> <lookback> <pattern>"
    exit $UNKNOWN
fi

MODE="$1"
UNIT="$2"
LOOKBACK="$3"
PATTERN="$4"

case "$MODE" in
    user)
        export XDG_RUNTIME_DIR="/run/user/$(id -u)"
        JOURNAL_FLAGS="--user"
        ;;
    system)
        JOURNAL_FLAGS=""
        ;;
    *)
        echo "Unknown mode '$MODE' (expected 'user' or 'system')"
        exit $UNKNOWN
        ;;
esac

OUTPUT=$(journalctl $JOURNAL_FLAGS -u "$UNIT" --since "-${LOOKBACK}" --no-pager 2>&1)
if [ $? -ne 0 ]; then
    echo "UNKNOWN - journalctl failed for $UNIT"
    exit $UNKNOWN
fi

MATCHES=$(printf '%s\n' "$OUTPUT" | grep -E "$PATTERN")
if [ -n "$MATCHES" ]; then
    echo "CRITICAL - pattern matched in $UNIT journal (last $LOOKBACK): $(printf '%s\n' "$MATCHES" | tail -1)"
    exit $CRITICAL
fi

echo "OK - no pattern match in $UNIT journal (last $LOOKBACK)"
exit $OK